# Copy to .env and fill in. Never commit .env.
# Optional - enables photo label reading, AI macro estimates and AI recipes.
ANTHROPIC_API_KEY=
# Optional - enables online recipe search with exact macros (free key: https://spoonacular.com/food-api/console)
SPOONACULAR_API_KEY=
# Model used for AI features (default: claude-opus-5-5)
THECHEF_MODEL=claude-opus-5-5
# Where the SQLite database lives
THECHEF_DB_PATH=data/thechef.db
# Set to true when served over HTTPS (required for secure cookies)
THECHEF_SECURE_COOKIES=false
# Set to false to stop new sign-ups (e.g. after creating your own account)
THECHEF_ALLOW_SIGNUP=true
# Public address of the app, e.g. https://thechef.example.com (needed for Google sign-in)
THECHEF_PUBLIC_URL=
# Optional - "Continue with Google". Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials with redirect URI
# <THECHEF_PUBLIC_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
